{
  "extends": ["airbnb/base", "plugin:import/errors", "plugin:import/warnings"],
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
  },
  "rules": {
    "import/no-mutable-exports": "off",
    "no-param-reassign": ["error", { "props": false }],
    "comma-dangle": [
      "error",
      {
        "arrays": "always-multiline",
        "objects": "always-multiline",
        "imports": "always-multiline",
        "exports": "always-multiline",
        "functions": "never",
      },
    ],
    "import/no-cycle": "off",
    "semi": ["error", "always"],
    "no-console": "warn",
    "prefer-const": "error",
    "space-infix-ops": "error",
    "no-plusplus": "off",
    "import/extensions": "off",
    "no-use-before-define": "off",
    "import/prefer-default-export": "off",
    "quotes": "off",
    "linebreak-style": ["off"],
    "object-curly-newline": [
      "error",
      {
        "ObjectExpression": { "multiline": true, "minProperties": 9 },
        "ObjectPattern": { "multiline": true, "minProperties": 9 },
        "ImportDeclaration": { "multiline": true, "minProperties": 9},
        "ExportDeclaration": "never",
      },
    ],
    "object-curly-spacing": ["error", "always"],
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "eol-last": ["error", "always"],
  },
}
